# 🦾 Jarvis 3.2 - Configuración

# Google Gemini API Keys
# Para rotación automática, podés agregar hasta 10 llaves.
# Obtenelas gratis en: https://aistudio.google.com/
GEMINI_API_KEY=tu_primer_llave_aca
GEMINI_API_KEY_1=tu_segunda_llave_aca
GEMINI_API_KEY_2=tu_tercer_llave_aca

# Configuración de Hardware
# ID del micrófono (usar scratch/list_audio_devices.py para encontrarlo)
# Por defecto 1 suele ser el micrófono interno en laptops Intel.
MIC_DEVICE_INDEX=1

# Sensibilidad del Wakeword (0.1 a 1.0)
# Valores bajos = Más sensible (ideal para voces bajas)
# Valores altos = Menos falsos positivos
WAKEWORD_SENSITIVITY=0.3

# Umbral de Silencio y Límites de Grabación
# AUDIO_PAUSE_THRESHOLD: Tiempo en segundos que Jarvis espera de silencio antes de finalizar la grabación.
# Establecido en 0.8 para una charla rápida y fluida sin interrupciones molestas.
AUDIO_PAUSE_THRESHOLD=0.8

# AUDIO_PHRASE_TIME_LIMIT: Duración máxima permitida para una frase hablada (en segundos).
# "None" para permitir frases indefinidamente largas (el fin de la grabación lo maneja el umbral de silencio).
AUDIO_PHRASE_TIME_LIMIT=None

# Biometría Vocal
# Umbral de confianza para la autenticación por voz (0.0 a 1.0).
# Valores altos = Más seguro (menos falsos positivos), pero puede rechazarte más seguido.
# Valores bajos = Más permisivo, pero menos seguro.
AUDIO_AUTH_THRESHOLD=0.85

